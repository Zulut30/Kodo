{
  "cargoVersion": "cargo 1.96.0 (30a34c682 2026-05-25)",
  "startDir": "",
  "workspace_root": "",
  "workspace_members": [
    {
      "name": "a",
      "manifest": "crates/a/Cargo.toml"
    }
  ],
  "manifests": {
    "Cargo.toml": "[workspace]\nresolver = \"2\"\nmembers = [\"crates/a\"]\nexclude = [\"nested/subws\"]\n",
    "crates/a/Cargo.toml": "[package]\nname = \"a\"\nversion = \"0.1.0\"\nedition = \"2021\"\n[dependencies]\ninner = { path = \"../../nested/subws/crates/inner\" }\n",
    "nested/subws/Cargo.toml": "[workspace]\nresolver = \"2\"\nmembers = [\"crates/*\"]\n",
    "nested/subws/crates/inner/Cargo.toml": "[package]\nname = \"inner\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
  }
}
