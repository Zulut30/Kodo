{
  "cargoVersion": "cargo 1.96.0 (30a34c682 2026-05-25)",
  "startDir": "",
  "workspace_root": "",
  "workspace_members": [
    {
      "name": "a",
      "manifest": "crates/a/Cargo.toml"
    },
    {
      "name": "b",
      "manifest": "crates/b/Cargo.toml"
    },
    {
      "name": "c",
      "manifest": "crates/c/Cargo.toml"
    }
  ],
  "manifests": {
    "Cargo.toml": "[workspace]\nresolver = \"2\"\nmembers = [\"crates/a\"]\nexclude = [\"crates/ext-excluded\"]\n",
    "crates/a/Cargo.toml": "[package]\nname = \"a\"\nversion = \"0.1.0\"\nedition = \"2021\"\n[dependencies]\nb = { path = \"../b\" }\next-excluded = { path = \"../ext-excluded\" }\n",
    "crates/b/Cargo.toml": "[package]\nname = \"b\"\nversion = \"0.1.0\"\nedition = \"2021\"\n[dev-dependencies]\nc = { path = \"../c\" }\n",
    "crates/c/Cargo.toml": "[package]\nname = \"c\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
    "crates/ext-excluded/Cargo.toml": "[package]\nname = \"ext-excluded\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
    "crates/orphan/Cargo.toml": "[package]\nname = \"orphan\"\nversion = \"0.1.0\"\nedition = \"2021\"\n"
  }
}
