{
  "name": "@zulut30/kodo",
  "version": "0.2.6",
  "private": true,
  "description": "Project-scoped skills, workflows and roles for Codex, Claude Code and OpenCode",
  "type": "module",
  "bin": {
    "kodo": "cli/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node cli/index.mjs",
    "validate": "node cli/index.mjs validate",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run validate && npm test"
  },
  "files": [
    "cli",
    "adapters",
    "runtime",
    "scripts/ci-reporter.mjs",
    "schemas",
    "skills",
    "agents",
    "pipelines",
    "mcp",
    "presets",
    "docs",
    "registry.json",
    "README.md",
    "third-party-skills.lock.json"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.15.0",
    "ajv": "^8.17.1",
    "smol-toml": "^1.9.1"
  }
}
